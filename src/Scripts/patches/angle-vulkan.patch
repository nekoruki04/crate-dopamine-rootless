diff --git a/src/libANGLE/renderer/vulkan/vk_renderer.cpp b/src/libANGLE/renderer/vulkan/vk_renderer.cpp
index 48f03ef..8dd4136 100644
--- a/src/libANGLE/renderer/vulkan/vk_renderer.cpp
+++ b/src/libANGLE/renderer/vulkan/vk_renderer.cpp
@@ -5410,7 +5410,17 @@ gl::Version Renderer::getMaxSupportedESVersion() const
     // Limit to ES2.0 if there are any blockers for 3.0.
 
     // VK_EXT_provoking_vertex is required for flat shading.
-    if (!mFeatures.provokingVertex.enabled)
+    //
+    // aTerm: except on MoltenVK, where the extension cannot exist -- Metal fixes
+    // the provoking vertex at the first one -- and where this one gate is all that
+    // stood between ES 2.0 and ES 3.1. Measured on Apple M3 / MoltenVK 1.4:
+    // every other ES 3.0 and 3.1 requirement passes, and compute shaders return
+    // correct results. The cost is that a `flat` varying takes the first vertex's
+    // value rather than the last, which only differs when one primitive's vertices
+    // carry different flat values. ES 3.2 stays out of reach regardless: there
+    // are no geometry shaders, so CanSupportGLES32 caps this at 3.1.
+    if (!mFeatures.provokingVertex.enabled &&
+        mDriverProperties.driverID != VK_DRIVER_ID_MOLTENVK)
     {
         maxVersion = LimitVersionTo(maxVersion, {2, 0});
     }
@@ -6575,9 +6585,18 @@ void Renderer::initFeatures(const vk::ExtensionNameList &deviceExtensionNames,
     // not disabled because primitive restart is not disabled outside tests.
     //
     // Also seeing rendering issues on PowerVR (http://b/472763050)
-    ANGLE_FEATURE_CONDITION(
-        &mFeatures, usePrimitiveTopologyDynamicState,
-        mFeatures.supportsExtendedDynamicState.enabled && !isARMProprietary && !isPowerVR);
+    //
+    // aTerm: and on MoltenVK, where it silently breaks GL_TRIANGLE_FAN. Metal has no
+    // fans, so MoltenVK emulates them -- but decides whether to from the pipeline's
+    // static topology. A fan supplied as dynamic state at draw time is drawn as a
+    // plain triangle list, so a 4-vertex fan quad renders only its first triangle.
+    // Weston composites with fans, and the result was half of every window never
+    // updating. Measured on Apple M3 / MoltenVK 1.4.2 with drawArrays and
+    // drawElements; strips were unaffected and ANGLE's Metal backend was correct.
+    const bool isMoltenVK = mDriverProperties.driverID == VK_DRIVER_ID_MOLTENVK;
+    ANGLE_FEATURE_CONDITION(&mFeatures, usePrimitiveTopologyDynamicState,
+                            mFeatures.supportsExtendedDynamicState.enabled && !isARMProprietary &&
+                                !isPowerVR && !isMoltenVK);
     ANGLE_FEATURE_CONDITION(&mFeatures, useStencilOpDynamicState,
                             mFeatures.supportsExtendedDynamicState.enabled);
     ANGLE_FEATURE_CONDITION(&mFeatures, useStencilTestEnableDynamicState,
