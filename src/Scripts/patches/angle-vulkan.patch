 void *OpenLibVulkan()
 {
+#if ANGLE_PLATFORM_IOS_FAMILY
+    // aTerm: in an iOS app, Vulkan is MoltenVK embedded in the bundle's Frameworks
+    // directory. No bare library name below can reach it, since an app cannot
+    // install anything into the system search path. Talk to MoltenVK directly
+    // rather than through the loader, which would also need an ICD manifest.
+    if (void *library =
+            OpenSystemLibraryWithExtension("MoltenVK.framework/MoltenVK", SearchType::ModuleDir))
+    {
+        return library;
+    }
+#endif
+
