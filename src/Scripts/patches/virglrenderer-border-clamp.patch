virglrenderer 1.3.0 on a GLES host without border clamp, which ANGLE on
MoltenVK is (its Vulkan backend needs VK_EXT_custom_border_color for
EXT_texture_border_clamp, and MoltenVK has none). convert_wrap hands back
GL_CLAMP_TO_BORDER regardless, ANGLE refuses it with GL_INVALID_ENUM, and the
sampler is left at REPEAT. Fall back to clamping to the edge instead, as
apply_sampler_border_color already skips the border colour there.
Scripts/build-virgl.sh applies it.

diff -ruN a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -2519,7 +2519,13 @@
    case PIPE_TEX_WRAP_CLAMP: if (vrend_state.use_core_profile == false) return GL_CLAMP; else return GL_CLAMP_TO_EDGE;
 
    case PIPE_TEX_WRAP_CLAMP_TO_EDGE: return GL_CLAMP_TO_EDGE;
-   case PIPE_TEX_WRAP_CLAMP_TO_BORDER: return GL_CLAMP_TO_BORDER;
+   case PIPE_TEX_WRAP_CLAMP_TO_BORDER:
+      /* crate: a GLES host without border clamp (ANGLE on MoltenVK) refuses
+       * GL_CLAMP_TO_BORDER, which leaves the sampler at REPEAT. The edge is
+       * the nearer thing it can do. */
+      if (vrend_state.use_gles && !has_feature(feat_sampler_border_colors))
+         return GL_CLAMP_TO_EDGE;
+      return GL_CLAMP_TO_BORDER;
 
    case PIPE_TEX_WRAP_MIRROR_REPEAT: return GL_MIRRORED_REPEAT;
    case PIPE_TEX_WRAP_MIRROR_CLAMP:
